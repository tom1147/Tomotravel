---
/**
 * セクションの見出し（h2）と説明文。
 * 見出しと説明文は左にまとめ、slot（「すべて見る」などのリンク）は右下に置きます。
 */
interface Props { title: string; lead?: string; id?: string; level?: 1 | 2; class?: string }
const { title, lead, id, level = 2, class: cls } = Astro.props;
const H = level === 1 ? 'h1' : 'h2';
const hasExtra = Astro.slots.has('default');
---
<header class:list={['sh', cls]}>
  <div class="sh__main">
    <H class="sh__title" id={id}>{title}</H>
    {lead && <p class="sh__lead">{lead}</p>}
  </div>
  {hasExtra && <div class="sh__extra"><slot /></div>}
</header>
