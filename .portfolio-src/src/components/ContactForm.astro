---
/**
 * お問い合わせフォーム。
 * 送信先は Tomo Travel（Netlify）の既存フォーム「contact」（src/config/site.ts の contact.formAction）。
 * Netlify は、デプロイ時に登録された項目名しか保存しないため、
 * 項目名は Tomo Travel 側のフォームと同じ name / email / subject / message にしています。
 * 「ご相談の種類」は subject として届きます（先頭に【ポートフォリオ】が付きます）。
 */
import { useI18n } from '../i18n';
import { site } from '../config/site';

const { t } = useI18n(Astro.url);
const f = t.contactPage.form;
---
<form class="cform" name={site.contact.formName} method="POST" action={site.contact.formAction} data-cform>
  <input type="hidden" name="form-name" value={site.contact.formName} />
  <p class="cform__trap" aria-hidden="true"><label>bot <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

  <div class="cform__grid" data-cform-field>
    <div class="cform__row">
      <label for="cf-name">{f.name}<span class="cform__req">{f.required}</span></label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required />
    </div>
    <div class="cform__row">
      <label for="cf-email">{f.email}<span class="cform__req">{f.required}</span></label>
      <input id="cf-email" name="email" type="email" autocomplete="email" inputmode="email" required />
    </div>
    <div class="cform__row cform__row--full">
      <label for="cf-subject">{f.topic}</label>
      <div class="cform__select">
        <select id="cf-subject" name="subject">
          {f.topics.map((x) => <option value={x.value}>{x.label}</option>)}
        </select>
      </div>
    </div>
    <div class="cform__row cform__row--full">
      <label for="cf-message">{f.message}<span class="cform__req">{f.required}</span></label>
      <textarea id="cf-message" name="message" rows="8" required placeholder={f.messagePlaceholder}></textarea>
    </div>
  </div>

  <div class="cform__foot" data-cform-field>
    <p class="cform__note">{f.note}</p>
    <button class="btn btn--lg" type="submit" data-sending={f.sending}>{f.submit}</button>
  </div>
  <p class="cform__error" role="alert" hidden data-cform-error>{f.error}</p>
  <div class="cform__done" role="status" tabindex="-1" hidden data-cform-done>
    <p>{f.done}</p>
  </div>
</form>
