---
import Brand from './Brand.astro';
import LangSwitch from './LangSwitch.astro';
import { useI18n } from '../i18n';
import { isCurrent } from '../lib/url';
const { t, u, paren } = useI18n(Astro.url);
const path = Astro.url.pathname;
const home = u('');
const items = [
  { href: u('works/'), label: t.nav.works },
  { href: u('services/'), label: t.nav.services },
  { href: u('pricing/'), label: t.nav.pricing },
  { href: u('about/'), label: t.nav.about },
];
const contact = u('contact/');
---
<header class="site-header" data-header>
  <div class="wrap site-header__inner">
    <Brand label={`Tomo ${t.brand.role}${paren(t.nav.home)}`} />
    <div class="site-header__right">
      <nav class="site-nav" id="site-nav" aria-label={t.a11y.mainNav}>
        {items.map((i) => (
          <a href={i.href} aria-current={isCurrent(path, i.href, home) ? 'page' : undefined}>{i.label}</a>
        ))}
        <a class="btn" href={contact} aria-current={isCurrent(path, contact, home) ? 'page' : undefined}>{t.nav.contact}</a>
      </nav>
      <LangSwitch id="lang-header" />
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle aria-label={t.nav.menu}>
        <span class="menu-toggle__bars" aria-hidden="true"></span>
        <span class="menu-toggle__label" data-menu-label data-open={t.nav.menu} data-close={t.nav.close}>{t.nav.menu}</span>
      </button>
    </div>
  </div>
</header>
