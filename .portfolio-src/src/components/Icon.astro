---
/** 装飾用アイコン。意味はテキスト側で伝え、アイコンは aria-hidden にする */
interface Props { name: 'external' | 'play' | 'pause' | 'download'; class?: string }
const { name, class: cls } = Astro.props;
---
{name === 'external' && (
  <svg class={cls} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 3H3.5A1.5 1.5 0 0 0 2 4.5v8A1.5 1.5 0 0 0 3.5 14h8a1.5 1.5 0 0 0 1.5-1.5V10M9.5 2H14v4.5M14 2 7.5 8.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
)}
{name === 'play' && (
  <svg class={cls} viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7.25" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M6.5 5.3v5.4L10.8 8z" fill="currentColor"/></svg>
)}
{name === 'pause' && (
  <svg class={cls} viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7.25" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M6.2 5.3h1.3v5.4H6.2zM8.5 5.3h1.3v5.4H8.5z" fill="currentColor"/></svg>
)}
{name === 'download' && (
  <svg class={cls} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 2v8.5M4.5 7 8 10.5 11.5 7M2.5 13.5h11" stroke-linecap="round" stroke-linejoin="round"/></svg>
)}
